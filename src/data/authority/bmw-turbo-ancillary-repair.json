    {
      "kind": "steps",
      "heading": "Our turbo repair process",
      "steps": [
        {
          "title": "Inspection & diagnosis",
          "body": "We assess turbo performance, check for shaft play, oil leaks, and wastegate operation, then confirm the root cause."
        },
        {
          "title": "Turbo removal",
          "body": "We access and unbolt the turbo, disconnecting oil and coolant lines. On hot-vee V8s, this is the most labour-intensive stage."
        },
        {
          "title": "Rebuild or replacement",
          "body": "We either rebuild the core with new bearings, seals, and balancing, or fit a factory-spec replacement unit."
        },
        {
          "title": "Ancillary component replacement",
          "body": "Wastegate actuators, oil feed lines, coolant lines, and all gaskets/seals are replaced as a set."
        },
        {
          "title": "Reinstallation & system bleed",
          "body": "The turbo is refitted, all lines reconnected, and cooling systems are bled to remove air."
        },
        {
          "title": "Testing & road test",
          "body": "We run leak tests, boost verification, and a full road test to confirm correct operation."
        }
      ]
    },
