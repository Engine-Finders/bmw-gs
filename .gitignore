# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# editor
.vscode/
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design/reference UI folders — not needed on GitHub
/BMW
/BMW-models
/EM - BMW Vairants Images Webp
/GS HP Mobile UI
/GS Homepage UI
/GS Modelpage UI
/GS Modelpage UI-Mobile
/Garage Site - Engine Pages BMW
/Garage Site - Vairant Pages BMW
/VariantPage UI
/engine-bmw-b58-ui

# assistant/agent config & internal planning docs — not needed on GitHub
/CLAUDE.md
/AGENTS.md
/Agents.md
/.claude/

# loose reference/handoff docs & source content — root-level only, so this
# never catches real .md/.txt files that end up inside src/ or public/
/*.md
!/README.md
/*.txt
/*.pdf

# scratch script output (debug logs, quality-test images)
/scripts/output/

.vercel

# python caches
__pycache__/
*.pyc
!/HANDOVER.md
