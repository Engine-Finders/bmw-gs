    {
      "kind": "steps",
      "heading": "Our Cylinder Head Rebuild Process",
      "steps": [
        {
          "title": "Removal & Strip-down",
          "body": "The head is removed from the engine and fully disassembled – valves, springs, retainers, and camshafts are taken out."
        },
        {
          "title": "Inspection & Measurement",
          "body": "We measure for warpage, cracks, and wear; valve guides and seats are checked with dial gauges and micrometers."
        },
        {
          "title": "Machining (Skimming)",
          "body": "The head is resurfaced on a precision machine to ensure a perfectly flat mating surface."
        },
        {
          "title": "Valve Work",
          "body": "Valves are ground or replaced, seats recut or replaced, and new stem seals fitted."
        },
        {
          "title": "VANOS Service",
          "body": "Where applicable, the VANOS unit is serviced to ensure correct variable valve timing."
        },
        {
          "title": "Reassembly",
          "body": "The head is reassembled with new gaskets, seals, and O-rings, then torqued to BMW specifications."
        },
        {
          "title": "Final Testing",
          "body": "We perform leak and pressure tests before the head is refitted to the vehicle."
        }
      ]
    },
