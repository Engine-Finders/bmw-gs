    {
      "kind": "faq",
      "heading": "Frequently Asked Questions",
      "items": [
        {
          "q": "Do you replace all gaskets and seals on every rebuild?",
          "a": "Yes. We never reuse old gaskets or seals. Every rebuild includes a full gasket set, with all seals replaced during reassembly."
        },
        {
          "q": "Are timing chains always replaced?",
          "a": "On affected engine families (N47/B47, N20/B48, N55/B58), the timing chain, guides, and tensioners are replaced as standard. On engines without known chain issues, we inspect and only replace if wear is found."
        },
        {
          "q": "Do you replace rod bearings on all engines?",
          "a": "Rod bearings are replaced on all bottom-end rebuilds regardless of engine type. On performance M-car engines (S54/S55/S58/S63/S65), we use upgraded bearings where available."
        },
        {
          "q": "What about oil pumps and water pumps?",
          "a": "Oil pumps are inspected and replaced if worn; oil pump chains are replaced when the timing chain is done. Water pumps are replaced on N55/B58 engines as a known wear item, and otherwise inspected and replaced if needed."
        }
      ]
    }
