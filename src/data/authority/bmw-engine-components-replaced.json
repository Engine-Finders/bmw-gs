      "kind": "steps",
      "heading": "Our Process",
      "steps": [
        {
          "title": "Strip-down",
          "body": "Engine removed from the car and fully dismantled. Every component inspected for wear."
        },
        {
          "title": "Machining (if required)",
          "body": "Cylinder bores are honed, crankshaft journals ground, and the block deck faced to spec."
        },
        {
          "title": "Component selection",
          "body": "New bearings, rings, gaskets, timing chains, and oil pump parts are selected per engine family."
        },
        {
          "title": "Reassembly",
          "body": "All new seals and fasteners used. Every bolt torqued to BMW factory specifications."
        }
      ]
    },
